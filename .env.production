# Production Environment Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database Configuration - Neon Cloud
# Replace with your actual Neon Cloud connection string
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# JWT Configuration
# IMPORTANT: Set a strong, random JWT secret in production
JWT_SECRET=

# Neon API Configuration (for programmatic database management)
# Get these from your Neon Console: https://console.neon.tech/
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Arcjet Configuration (API security and rate limiting)
# Get your key from: https://app.arcjet.com/
ARCJET_KEY=

# Additional Production Settings
# Uncomment and configure as needed
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# TRUSTED_PROXIES=1
